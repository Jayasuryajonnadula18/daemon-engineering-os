{
  "name": "daemon-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Daemon engineering intelligence CLI",
  "bin": {
    "daemon": "dist/bin/daemon.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node src/index.ts",
    "start": "npm run build && node dist/index.js",
    "lint": "eslint . --ext .ts",
    "doctor": "npm run build && node dist/index.js doctor"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "boxen": "^7.1.0",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.2",
    "commander": "^11.0.0",
    "execa": "^7.1.1",
    "log-symbols": "^5.1.0",
    "ora": "^6.1.2"
  },
  "devDependencies": {
    "@types/boxen": "^3.0.5",
    "@types/node": "^20.11.0",
    "@types/log-symbols": "^3.0.0",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^10.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  }
}
